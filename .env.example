# Copy to .env and fill in. Either option A or option B is enough.
# .env is gitignored; never commit real credentials.

# --- Option A: Webshare API key -------------------------------------------
# The script calls https://proxy.webshare.io/api/v2/proxy/list/ and picks a
# working proxy in the country below.
WEBSHARE_API_KEY=

# --- Option B: one proxy, pasted directly ---------------------------------
WEBSHARE_PROXY_HOST=
WEBSHARE_PROXY_PORT=
WEBSHARE_PROXY_USER=
WEBSHARE_PROXY_PASS=

# Required exit country. The booking session is pinned to its source IP, so the
# chosen proxy is verified once and then never rotated mid-flow.
WEBSHARE_COUNTRY=US
